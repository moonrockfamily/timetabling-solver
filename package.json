{
  "name": "@moonrockfamily/timetabling-solver",
  "version": "1.0.0",
  "description": "Time-tabling solver using genetic algorithms and constraint programming",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "start": "node examples/sample.js || node -r ts-node/register examples/sample.ts",
    "dev": "ts-node examples/sample.ts",
    "debug": "node --inspect-brk -r ts-node/register examples/sample.ts",
    "test": "mocha -r ts-node/register test/**/*.spec.ts",
    "lint": "eslint --ext .ts src test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "genetic-js-no-ww": "github:framp/genetic-js-no-ww",
    "ics": "^3.8.1",
    "node-ical": "^0.25.3",
    "rrule": "^2.7.1"
  },
  "devDependencies": {
    "date-fns": "^4.1.0",
    "date-fns-fp": "^4.1.0",
    "@types/chai": "^4.3.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.16.18",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "chai": "^4.3.7",
    "eslint": "^10.0.2",
    "mocha": "^12.0.0-beta-3",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.6"
  },
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/moonrockfamily/timetabling-solver.git"
  },
  "bugs": {
    "url": "https://github.com/moonrockfamily/timetabling-solver/issues"
  },
  "homepage": "https://github.com/moonrockfamily/timetabling-solver#readme",
  "keywords": [
    "timetabling",
    "scheduling",
    "genetic algorithm",
    "availability",
    "rrule"
  ],
  "license": "MIT"
}
